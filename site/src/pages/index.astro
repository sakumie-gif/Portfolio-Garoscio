---
// Reproduction fidèle de la maquette Figma « Page Principal » (node 51:9945).
// Tous les visuels, couleurs, typos et textes viennent de la maquette (assets
// exportés via le MCP Figma). Page autonome : elle porte son propre header et
// son propre footer, conformes à la maquette (les composants partagés du site
// ne correspondent pas et ne sont pas modifiés).
// Seule exception, demandée par Audrey : les DONNÉES des tuiles projets
// (visuels, descriptions, rôles, liens) sont celles du portfolio actuel,
// pas les exemples de la maquette.
import "../styles/global.css";
import Icone from "../components/Icone.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const projets = [
  {
    href: "/works/pool-party",
    image: "/images/poolparty-page-daccueil-maquette-page-daccueil-ordinateur.jpg",
    tag: "Marketplace",
    tagBg: "#f76049", // Color/corail
    titre: "Pool Party",
    texte: "Marketplace P2P de location de piscines.",
    role: "Cheffe de projet, de bout en bout",
  },
  {
    href: "/works/sumo-tournament",
    image: "/images/sumo-home.png",
    tag: "Événementiel",
    tagBg: "#b88d1a", // Color/yellow
    titre: "Sumo Tournament",
    texte: "Site événementiel et back-office.",
    role: "Conception et mise en production",
  },
  {
    href: "/works/pool-and-splash",
    image: "/images/homepage.png",
    tag: "Refonte UI",
    tagBg: "#9a2737", // Color/lie de vin
    titre: "Pool & Splash",
    texte: "Refonte UI, direction kidulting.",
    role: "Direction artistique et UI",
  },
];

// Étapes du process : blob teinté (token à 10 %) + icône colorée, exports
// exacts de la maquette.
const etapes = [
  {
    blob: "/images/figma-blob-1.svg",
    icone: "/images/figma-proc-icon-1.svg",
    num: "01",
    titre: "Comprendre",
    texte: "J'explore les besoins utilisateurs,\nles objectifs métier et les contraintes.",
  },
  {
    blob: "/images/figma-blob-2.svg",
    icone: "/images/figma-proc-icon-2.svg",
    num: "02",
    titre: "Structurer",
    texte: "Je pose les fondations de l'expérience : parcours, architecture, contenu.",
  },
  {
    blob: "/images/figma-blob-3.svg",
    icone: "/images/figma-proc-icon-3.svg",
    num: "03",
    titre: "Concevoir",
    texte: "Je crée des interfaces claires, utiles et alignées avec la stratégie produit.",
  },
  {
    blob: "/images/figma-blob-4.svg",
    icone: "/images/figma-proc-icon-4.svg",
    num: "04",
    titre: "Tester",
    texte: "Je confronte, j'itère et j'améliore en continu avec les utilisateurs.",
  },
  {
    blob: "/images/figma-blob-5.svg",
    icone: "/images/figma-proc-icon-5.svg",
    num: "05",
    titre: "Livrer",
    texte: "Je collabore avec les développeurs et je m'assure d'un produit accessible et durable.",
  },
];

// Coulisses : une vignette dédiée par tuile (sources : img/ et img/planches).
const coulisses = [
  {
    image: "/images/coulisse-wireframes.png",
    titre: "Recherche & Wireframes",
    note: "Explorer vite, tester tôt.",
  },
  {
    image: "/images/coulisse-annotations.png",
    titre: "Annotations & idées",
    note: "Penser avec clarté.",
  },
  {
    image: "/images/coulisse-composants.png",
    titre: "Composants réutilisables",
    note: "Cohérence et efficacité.",
  },
  {
    image: "/images/coulisse-accessibilite.png",
    titre: "Accessibilité",
    note: "Concevoir pour tous.",
  },
  {
    image: "/images/coulisse-avant-apres.png",
    titre: "Avant / Après",
    note: "Mesurer l'impact réel.",
  },
];

const apropos = [
  {
    icone: "/images/figma-apropos-1.svg",
    texte: "Une expertise des produits SaaS B2B et des outils métier",
  },
  {
    icone: "/images/figma-apropos-2.svg",
    texte: "Je transforme des parcours complexes en interfaces claires",
  },
  {
    icone: "/images/figma-apropos-3.svg",
    texte: "Culture produit, rigueur et empathie",
  },
  {
    icone: "/images/figma-apropos-4.svg",
    texte: "Une attention particulière portée à l'accessibilité et à la cohérence",
  },
];

---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Audrey Garoscio — Product Designer UX/UI</title>
    <meta
      name="description"
      content="Product Designer UX/UI, j'accompagne la conception d'interfaces SaaS B2B complexes, du wireframe au prototype."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600;700&family=Caveat:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <!-- Fond #F7F4F2 : la couleur de fond de la maquette, identique au fond de
       l'image portrait-audrey-rideau — le portrait se fond ainsi dans la page.
       En style inline : la règle body de global.css (non-layered) l'emporte
       sur les utilitaires Tailwind (layered). -->
  <body style="background-color:#f7f4f2">
    <a class="skip-link" href="#contenu">Aller au contenu</a>

    <Nav current="" />

    <main id="contenu" tabindex="-1">
      <!-- Introduction (maquette node 56:1154) : le portrait touche le bord
           droit de l'écran, le texte est calé sur la marge de 80px.
           Sous 1920, tout est proportionnel : portrait en %, titre en clamp,
           retours à la ligne forcés seulement quand la colonne est assez
           large (2xl). -->
      <!-- Portrait (choix d'Audrey, 20/07) : collé au bord droit de l'écran
           jusqu'au 14 pouces (1280px) inclus ; au-delà, son bord droit
           s'aligne sur la marge du reste du contenu (min-[1281px]:pr =
           marge de la grille), pour ne plus dépasser les cartes sur grand
           écran. Le texte reste aligné sur cette même grille via sa marge
           gauche max(80px, 50vw-880px). -->
      <section class="flex w-full flex-col gap-10 lg:flex-row lg:items-start lg:gap-6 min-[1281px]:pr-[max(80px,calc(50vw_-_880px))]">
        <div class="min-w-0 flex-1 px-6 pt-8 sm:px-10 xl:pr-0 xl:pl-[max(80px,calc(50vw_-_880px))]">
          <p class="flex items-center gap-[14px] py-3.5 font-display text-lg font-semibold text-encre sm:text-xl">
            <Icone nom="etoile" taille={38} class="shrink-0" />
            THÉÂTRE CONTEMPORAIN DU PRODUCT DESIGN
          </p>

          <h1 class="pb-[50px] font-display text-4xl font-bold leading-[normal] text-encre sm:text-5xl lg:text-[clamp(40px,3.34vw,64px)]">
            Je conçois des produits<br />
            clairs, utiles et
            <span class="relative inline-block text-accent">
              humains.
              <img
                src="/images/trait-souligne.png"
                alt=""
                aria-hidden="true"
                class="pointer-events-none absolute left-0 top-full w-full"
              />
            </span>
          </h1>

          <p class="text-base font-semibold leading-[normal] text-encre sm:text-lg">
            Product Designer UX/UI, j'accompagne la conception d'interfaces SaaS B2B complexes,<br
              class="hidden 2xl:block"
            />
            du wireframe au prototype, en collaboration étroite avec les Product Owners, les<br
              class="hidden 2xl:block"
            />
            développeurs et les métiers.
          </p>

          <!-- Tags (node 58:1098) : fond token/10, texte et icône de la même
               teinte, coins 10px, ombre portée. -->
          <ul class="flex flex-wrap items-center gap-5 py-[14px] pt-6">
            <li
              class="flex items-center justify-center gap-1 rounded-[10px] bg-[rgba(154,39,55,0.1)] px-[14px] py-2 shadow-[0px_4px_6px_0px_rgba(0,0,0,0.1),0px_2px_4px_0px_rgba(0,0,0,0.1)]"
            >
              <img src="/images/figma-tag-designer.svg" alt="" aria-hidden="true" class="size-4" />
              <span class="text-sm text-[#9a2737]">Product Designer UX/UI</span>
            </li>
            <li
              class="flex items-center justify-center gap-1 rounded-[10px] bg-[rgba(184,141,26,0.1)] px-[14px] py-2 shadow-[0px_4px_6px_0px_rgba(0,0,0,0.1),0px_2px_4px_0px_rgba(0,0,0,0.1)]"
            >
              <img src="/images/figma-tag-saas.svg" alt="" aria-hidden="true" class="h-[14px] w-4" />
              <span class="text-sm text-[#b88d1a]">SaaS B2B</span>
            </li>
            <li
              class="flex items-center justify-center gap-1 rounded-[10px] bg-[rgba(74,110,137,0.1)] px-[14px] py-2 shadow-[0px_4px_6px_0px_rgba(0,0,0,0.1),0px_2px_4px_0px_rgba(0,0,0,0.1)]"
            >
              <img src="/images/figma-tag-a11y.svg" alt="" aria-hidden="true" class="size-4" />
              <span class="text-sm text-[#4a6e89]">Accessibilité</span>
            </li>
          </ul>

        </div>

        <!-- portrait-audrey-rideau (node 56:1156), collé au bord droit.
             Le conteneur « Recherche + CV » (58:1157) est masqué dans la
             maquette : il n'est pas rendu. -->
        <img
          src="/images/portrait-audrey-rideau.png"
          alt="Portrait d'Audrey Garoscio"
          width="848"
          height="607"
          class="w-full self-start lg:w-[38.7%] lg:max-w-[742px]"
        />
      </section>

      <!-- Projets (nodes 15117:948 + 59:1312 + 58:1221) -->
      <section id="projets" class="mx-auto max-w-[1920px] px-6 pt-8 sm:px-10 xl:px-20">
        <!-- Actualité (node 15117:948) : carte bordée lie-de-vin, posée à plat
             sur le fond de page — sans ombre, qui lui donnait un air de carte
             blanche flottante. -->
        <div
          class="flex flex-col items-start gap-[14px] rounded-[20px] border border-accent p-5"
        >
          <p
            class="rounded-[10px] bg-[rgba(154,39,55,0.1)] px-[14px] py-2 text-sm font-bold text-accent shadow-[0px_4px_6px_0px_rgba(0,0,0,0.1),0px_2px_4px_0px_rgba(0,0,0,0.1)]"
          >
            ACTUALITÉ
          </p>
          <p class="text-sm leading-[normal] text-encre">
            Pool Party, le site présenté à ma soutenance, est en ligne.<br />
            L'accès est protégé par un code jusqu'en septembre : écrivez-moi et je vous le
            communique.
          </p>
        </div>

        <p class="mt-14 flex items-center gap-[14px] py-2 font-display text-2xl font-semibold text-encre sm:text-[28px]">
          <Icone nom="etoile" taille={38} class="shrink-0" />
          À L'AFFICHE
        </p>
        <div class="mt-2.5 flex flex-wrap items-center justify-between gap-4">
          <h2 class="font-display text-2xl font-semibold text-encre sm:text-[28px]">
            Projets sélectionnés
          </h2>
          <!-- Le trait est en absolu : en flux (w-full dans un flex-col), sa
               largeur naturelle (~460px) élargissait le lien et il dépassait
               largement du texte. En absolu, il fait exactement la largeur
               du libellé, comme sur la maquette. -->
          <a
            href="/works"
            class="note relative inline-block py-2 text-2xl font-normal drop-shadow-[0px_10px_7.5px_rgba(0,0,0,0.1),0px_4px_3px_rgba(0,0,0,0.1)] transition-transform hover:scale-[1.03]"
          >
            Voir tous les projets
            <img
              src="/images/trait-souligne.png"
              alt=""
              aria-hidden="true"
              class="pointer-events-none absolute bottom-0 left-0 w-full"
            />
          </a>
        </div>

        <!-- Tuiles : design de la maquette, données du portfolio actuel.
             « Stretched link » : seul le titre est un lien, son ::after couvre
             la carte entière ; l'image est décorative. -->
        <ul class="mt-5 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            projets.map((p) => (
              <li class="group relative flex flex-col rounded-[10px] rounded-tl-none border border-[rgba(186,186,186,0.3)] bg-white transition-colors hover:border-encre/25">
                <div class="flex h-60 items-start justify-center overflow-hidden rounded-tr-[10px] border-b border-trait-2 bg-[rgba(154,39,55,0.1)] pt-5">
                  <img src={p.image} alt="" loading="lazy" class="h-full w-[87%] object-cover object-top" />
                </div>
                <div class="flex flex-1 flex-col items-start gap-2 px-4 py-[14px]">
                  <span
                    class="rounded-[10px] px-[14px] py-2 text-sm text-white drop-shadow-[0px_4px_3px_rgba(0,0,0,0.1),0px_2px_2px_rgba(0,0,0,0.1)]"
                    style={`background-color:${p.tagBg}`}
                  >
                    {p.tag}
                  </span>
                  <h3 class="font-display text-xl font-semibold text-[#393939]">
                    <a href={p.href} class="after:absolute after:inset-0 after:content-['']">
                      {p.titre}
                    </a>
                  </h3>
                  <p class="text-sm text-encre">{p.texte}</p>
                  <div class="w-full border-t border-trait" aria-hidden="true" />
                  <p class="flex items-center gap-2 text-sm">
                    <span class="text-base font-semibold text-[#f76049]">Rôle</span>
                    <span class="text-encre">{p.role}</span>
                  </p>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="mt-16 border-t border-trait-2" aria-hidden="true"></div>

        <!-- Ma manière de travailler (node 59:1350) : rangée maquette avec
             connecteurs pointillés et tuiles fixes de 194px dès xl. -->
        <div class="flex flex-col gap-8 pt-16 xl:flex-row xl:items-start xl:gap-2.5">
          <div class="flex w-full flex-col gap-[30px] xl:w-[422px] xl:shrink-0">
            <p class="font-display text-lg font-semibold sm:text-xl">
              <span class="text-accent">M</span><span class="text-encre">A MANIÈRE DE TRAVAILLER</span>
            </p>
            <h2 class="font-display text-2xl font-semibold text-encre sm:text-[28px]">
              De la compréhension à l'impact
            </h2>
          </div>

          <ol class="grid flex-1 grid-cols-1 gap-8 sm:grid-cols-2 xl:flex xl:items-start xl:gap-0">
            {
              etapes.map((e, i) => (
                <>
                  <li class="flex w-full flex-col items-start gap-2 rounded-[10px] xl:w-[194px] xl:shrink-0">
                    <div class="relative h-[92.5px] w-[117.5px] self-center">
                      <img src={e.blob} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full" />
                      <img
                        src={e.icone}
                        alt=""
                        aria-hidden="true"
                        class="absolute left-1/2 top-1/2 size-10 -translate-x-1/2 -translate-y-1/2"
                      />
                    </div>
                    <p class="text-lg font-semibold text-accent" aria-hidden="true">
                      {e.num}
                    </p>
                    <h3 class="text-lg font-semibold text-encre">{e.titre}</h3>
                    <p class="whitespace-pre-line text-base text-encre">{e.texte}</p>
                  </li>
                  {i < etapes.length - 1 && (
                    <li class="hidden min-w-0 flex-1 pt-[58px] xl:block" aria-hidden="true">
                      <img src="/images/figma-line-dashed.svg" alt="" class="h-[5px] w-full" />
                    </li>
                  )}
                </>
              ))
            }
          </ol>
        </div>

        <div class="mt-16 border-t border-trait-2" aria-hidden="true"></div>

        <!-- Dans les coulisses (node 60:534) -->
        <div id="coulisses" class="flex flex-col gap-8 pb-20 pt-16 xl:flex-row xl:items-start xl:gap-[14px]">
          <div class="flex w-full flex-col gap-[30px] xl:w-[19.6%] xl:shrink-0">
            <p class="font-display text-lg font-semibold sm:text-xl">
              <span class="text-accent">D</span><span class="text-encre">ANS LES COULISSES</span>
            </p>
            <h2 class="relative font-display text-2xl font-semibold text-encre sm:text-[28px]">
              Un design pensé, testé et documenté.
              <img
                src="/images/trait-souligne.png"
                alt=""
                aria-hidden="true"
                class="pointer-events-none absolute -bottom-6 left-[20%] w-[208px]"
              />
            </h2>
          </div>

          <ul class="grid flex-1 grid-cols-2 gap-[14px] sm:grid-cols-3 xl:grid-cols-5">
            {
              coulisses.map((c) => (
                <li class="flex flex-col rounded-[10px] rounded-tl-none border border-[rgba(186,186,186,0.3)] bg-white">
                  <div class="flex h-[167px] items-end justify-center overflow-hidden rounded-tr-[10px] border-b border-trait-2 bg-[rgba(154,39,55,0.1)]">
                    <img
                      src={c.image}
                      alt=""
                      loading="lazy"
                      class="h-[147px] w-[89%] object-cover object-top"
                    />
                  </div>
                  <div class="flex flex-1 flex-col gap-2 px-4 py-2">
                    <h3 class="text-base font-semibold text-[#393939]">{c.titre}</h3>
                    <p class="text-xs text-encre">{c.note}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- A propos (node 60:809). Largeurs proportionnelles au cadre 1760 de
             la maquette (311 / 431 / 488 / reste) : des largeurs fixes en px
             écrasaient la derniere colonne sur les écrans plus étroits. -->
        <div class="flex flex-col gap-8 pb-24 xl:flex-row xl:items-start xl:gap-5">
          <img
            src="/images/figma-about-photo.png"
            alt="Audrey Garoscio en costume de scène, lors d'un spectacle historique"
            width="311"
            height="430"
            loading="lazy"
            class="mx-auto h-auto w-[260px] shrink-0 object-cover xl:mx-0 xl:w-[17.7%]"
          />

          <div class="flex w-full flex-col gap-2.5 xl:w-[24.5%] xl:shrink-0">
            <p class="flex items-center gap-[14px] py-5 text-lg font-semibold text-encre">
              <Icone nom="etoile" taille={38} class="shrink-0" />
              À PROPOS
            </p>
            <h2 class="font-display text-3xl font-bold leading-[normal] text-encre sm:text-[40px] xl:text-[clamp(28px,2.1vw,40px)]">
              De costumière<br />à Product Designer
            </h2>
          </div>

          <div class="relative flex w-full flex-col gap-6 border-trait-2 pr-5 xl:w-[27.7%] xl:shrink-0 xl:gap-[78px] xl:border-r xl:pt-[104px]">
            <p class="text-lg font-semibold leading-[normal] text-encre">
              Ma première scène, ma passion, c'est le théâtre. Costumière de formation, j'ai
              appris à écouter les intentions, comprendre les personnages et raconter des
              histoires à travers chaque détail. Aujourd'hui, je conçois des interfaces qui
              mettent en scène des expériences utiles, accessibles et mémorables.
            </p>
            <p class="note -rotate-3 text-3xl font-normal sm:text-[36px]">
              Même exigence, autre décor !
            </p>
          </div>

          <ul class="flex flex-1 flex-col justify-center gap-6 px-0 xl:gap-[34px] xl:self-stretch xl:px-5">
            {
              apropos.map((a) => (
                <li class="flex items-start gap-2">
                  <img src={a.icone} alt="" aria-hidden="true" class="size-8 shrink-0" />
                  <p class="flex-1 text-lg font-semibold leading-[normal] text-voile-fort">{a.texte}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
