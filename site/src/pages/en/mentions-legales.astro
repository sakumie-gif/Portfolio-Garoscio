---
// English mirror of mentions-legales.astro (legal notice).
import Base from "../../layouts/Base.astro";

const dateMaj = "June 2026";
---

<Base title="Legal notice — Audrey Garoscio" description="Legal information for this website." current="" lang="en">
  <section class="mx-auto max-w-3xl px-6 pt-10 sm:px-10 sm:pt-16">
    <p class="text-xs uppercase tracking-[0.2em] text-accent">Legal notice</p>
    <h1 class="mt-4 text-4xl font-extrabold sm:text-5xl">
      For good practice
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-voile">
      Legal information for this website, in accordance with the French law
      for confidence in the digital economy (LCEN) of June 21, 2004.
    </p>

    <div class="mt-12 space-y-10 text-base leading-relaxed">
      <section>
        <h2 class="text-xl font-bold">Site publisher</h2>
        <p class="mt-3">
          Audrey Garoscio, first-year MBA student in Marketing, Communication
          and Digital Design at Digital School Paris (IEF2I), based in
          Île-de-France. This site is a personal portfolio for professional
          presentation purposes, with no commercial activity.
        </p>
        <p class="mt-2">
          Contact:
          <a href="mailto:product.garoscio@gmail.com" class="underline decoration-accent decoration-2 underline-offset-4">
            product.garoscio@gmail.com
          </a>
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold">Publication director</h2>
        <p class="mt-3">Audrey Garoscio.</p>
      </section>

      <section>
        <h2 class="text-xl font-bold">Hosting</h2>
        <p class="mt-3">
          Vercel Inc., 440 N Barranca Avenue #4133, Covina, CA 91723, United
          States.
          <br />
          Website:
          <a href="https://vercel.com" target="_blank" rel="noopener noreferrer" class="underline decoration-accent decoration-2 underline-offset-4">
            vercel.com
          </a>
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold">Intellectual property</h2>
        <p class="mt-3">
          All content on this site (texts, images, mockups, visual identities,
          layouts) is the property of Audrey Garoscio unless stated otherwise.
          Any reproduction or reuse, in whole or in part, requires prior
          written permission.
        </p>
        <p class="mt-3">
          The projects shown were produced in an educational or personal
          context and are published for demonstration purposes.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold">Personal data</h2>
        <p class="mt-3">
          This site sets no cookies and uses no audience measurement tools or
          third-party tracking services.
        </p>
        <p class="mt-3">
          The site includes a contact form. Submissions are processed by
          Formspree (Formspree Inc.), which forwards your message to my email
          address. The information you enter (name, email address, message) is
          used solely to reply to you and is neither sold nor used for any
          other purpose. You can also email me directly, without using the
          form.
        </p>
        <p class="mt-3">
          In accordance with the General Data Protection Regulation (GDPR),
          you can request access to, rectification of, or deletion of this
          information at any time by replying by email.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold">Credits</h2>
        <p class="mt-3">
          Design and copy: Audrey Garoscio.
          <br />
          Typefaces: Poppins, Inter and Caveat, served through Google Fonts
          under open licenses.
          <br />
          Built with: Astro, Tailwind CSS.
        </p>
      </section>

      <p class="pt-6 text-sm text-voile">
        Last updated: {dateMaj}.
      </p>
    </div>
  </section>
</Base>
