---
import Base from "../layouts/Base.astro";
---

<Base title="Page introuvable — Audrey Garoscio" current="">
  <section class="relative mx-auto flex min-h-[50vh] max-w-3xl flex-col justify-center px-6 py-20 sm:px-10">
    <div class="blob right-0 top-0 h-56 w-56 bg-corail/15" aria-hidden="true"></div>

    <p class="text-xs uppercase tracking-[0.2em] text-accent">Erreur 404</p>
    <h1 class="mt-4 text-5xl font-extrabold leading-[1.03] sm:text-6xl">
      Rideau<span class="text-accent">.</span>
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-voile">
      Cette page a quitté l'affiche, ou n'est jamais montée sur scène. La
      représentation que vous cherchez est introuvable.
    </p>

    <div class="mt-9">
      <a
        href="/"
        class="group inline-flex items-center gap-2.5 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-ivoire transition-transform hover:scale-[1.02]"
      >
        Revenir à l'entrée
        <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>

    <p class="note mt-16 -rotate-1">« Toute sortie est une entrée quelque part. »</p>
  </section>
</Base>
