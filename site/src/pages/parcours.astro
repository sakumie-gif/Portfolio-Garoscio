---
import Base from "../layouts/Base.astro";
import Bouton from "../components/Bouton.astro";
import Icone from "../components/Icone.astro";

const experiences = [
  {
    dates: "Février 2025 à septembre 2026 (en cours, alternance)",
    poste: "Product Designer UX/UI",
    employeur: "EasyVista",
    missions: [
      "Analyse et formalisation des besoins utilisateurs pour identifier les points de friction dans les parcours agents, administrateurs et utilisateurs finaux.",
      "Création de wireframes, maquettes haute fidélité et prototypes interactifs sur Figma pour des interfaces SaaS B2B.",
      "Contribution au design system : composants Figma, styles, règles d'usage, cohérence graphique, accessibilité.",
      "Préparation de la transmission aux développeurs : maquettes propres, comportements détaillés, spécifications fonctionnelles, suivi de l'implémentation.",
      "Participation aux tests utilisateurs, recette UX/UI, contrôle du rendu responsive.",
      "Collaboration avec PO, développeurs et équipes métier.",
      "Contribution à l'amélioration de 24 composants du design system.",
      "Suivi de 6 fonctionnalités jusqu'à leur passage en développement.",
    ],
  },
  {
    dates: "2024",
    poste: "Technicienne administrative",
    employeur: "URSSAF",
    missions: [
      "Accompagnement des employeurs sur le dispositif TESE par téléphone et mail, avec écoute, reformulation et vulgarisation des informations.",
      "Fiabilisation des données employeurs : saisie, vérification et mise à jour des déclarations.",
      "Contrôle de la conformité des pièces et détection des anomalies.",
      "Traçabilité des actions et suivi administratif, classement et mise à jour des fichiers.",
    ],
  },
  {
    dates: "2019",
    poste: "Conseillère de vente",
    employeur: "Pronuptia",
    missions: [
      "Conseil personnalisé et accompagnement des clientes en robes de mariée.",
      "Présentation, mise en valeur et organisation des rayons.",
      "Prise de mesures et suivi des retouches avec l'atelier.",
    ],
  },
  {
    dates: "2017 à 2018",
    poste: "Costumière et habilleuse",
    employeur: "Disneyland Paris",
    missions: [
      "Habilleuse sur les shows Marvel.",
      "Gestion des stocks de costumes et organisation des loges.",
      "Création, ajustements et entretien de chapeaux et accessoires pour les spectacles.",
    ],
  },
  {
    dates: "Juillet et septembre 2017",
    poste: "Costumière et chapelière",
    employeur: "FBG 22-11, Paris",
    missions: [
      "Costumière et chapelière pour Disneyland Paris.",
    ],
  },
  {
    dates: "Mai à juin 2017",
    poste: "Costumière",
    employeur: "IDZ Production, Paris",
    // Une mission peut être une chaîne simple, ou { texte, lien, libelle }
    // pour ajouter un lien vidéo à la fin (règle des 3 boutons : un lien
    // dans une phrase est un texte souligné, pas un bouton).
    missions: [
      {
        texte: "Réalisation du costume de Norman pour le clip musical « Zelda ».",
        lien: "https://www.youtube.com/watch?v=ci8HQFF6d5A",
        libelle: "Voir le clip sur YouTube",
      },
      {
        texte:
          "Réalisation des costumes d'extra-terrestres pour une vidéo de promotion du film « Valérian » de Jimmy.",
        lien: "https://www.youtube.com/watch?v=0gMW3ijIczI",
        libelle: "Voir la vidéo sur YouTube",
      },
    ],
  },
];

const formations = [
  {
    dates: "2025 à 2026",
    intitule: "MBA1 et B3 Chef de projet digital, Design et Digital marketing",
    lieu: "Institut IEF2I, Digital School Paris, Vincennes",
  },
  {
    dates: "2016",
    intitule: "CAP Chapelier Modiste",
    lieu: "Lycée La Source, Nogent-sur-Marne",
  },
  {
    dates: "2015",
    intitule: "DMA Costumier Réalisateur",
    lieu: "Lycée des Coteaux, Cannes",
  },
  {
    dates: "2013",
    intitule: "DTMS Habillage",
    lieu: "Lycée La Source, Nogent-sur-Marne",
  },
  {
    dates: "2010",
    intitule: "Baccalauréat STG, comptabilité et finances des entreprises",
    lieu: "Lycée Cabrini, Noisy-le-Grand",
  },
];

const competences = [
  "Recherche utilisateur",
  "Parcours client",
  "Wireframes",
  "Prototypage Figma",
  "Maquettes UI",
  "UI design",
  "Design system",
  "Responsive design",
  "Mobile first",
  "Accessibilité",
  "Tests utilisateurs",
  "Recette UX/UI",
  "Spécifications UX/UI",
  "Benchmark concurrentiel",
  "Interface web",
];

// Chiffres tirés des missions réelles listées plus bas, pas de mesures
// d'impact fabriquées : le concept écarte explicitement les « 100 % de
// réussite » invérifiables.
// ⚠ Section retirée de l'affichage : la nouvelle maquette du haut de page
// (node Figma 15122:1459) ne comporte plus les tuiles chiffres-clés.
// Données conservées ici au cas où elles reviendraient.
// const chiffres = [
//   { valeur: "24", libelle: "composants du design system améliorés" },
//   { valeur: "6", libelle: "fonctionnalités suivies jusqu'au développement" },
//   { valeur: "2025", libelle: "Product Designer chez EasyVista depuis" },
// ];

const outils = [
  {
    titre: "Design et illustration",
    lignes: [
      "Figma, Illustrator, Photoshop, InDesign, Clip Studio Paint, Krita, Inkscape, Vegas Pro",
    ],
  },
  {
    titre: "Collaboration et environnement",
    lignes: ["VS Code, Notion, Loop, Teams, Discord, Suite Office, IA générative"],
  },
  {
    titre: "Langues",
    lignes: ["Français, langue maternelle", "Anglais, compréhension écrite"],
  },
];
---

<Base title="Parcours — Audrey Garoscio" current="parcours">
  <!-- Haut de page refait sur la maquette Figma « Page Principal » parcours
       (node 15122:1459) : titre étoilé « Le programme », « Parcours. » avec
       trait souligné, note manuscrite à droite, bouton CV, séparateur puis
       titre EXPÉRIENCE. La suite (timeline, formation, compétences, outils)
       est conservée telle quelle, comme demandé. -->
  <section class="mx-auto max-w-[1920px] px-6 pt-8 sm:px-10 xl:px-20">
    <div class="grid gap-8 xl:grid-cols-[1fr_clamp(400px,36.6vw,703px)] xl:items-start">
      <div>
        <p class="flex items-center gap-3.5 py-3.5 font-display text-xl font-semibold">
          <Icone nom="etoile" taille={38} class="shrink-0" /> Le programme
        </p>
        <!-- Tailles proportionnelles (clamp, comme l'accueil et le contact) :
             la maquette est dessinée à 1920. -->
        <h1 class="mt-2 font-display text-4xl font-bold leading-[normal] sm:text-5xl lg:text-[clamp(40px,3.34vw,64px)]">
          <span class="relative inline-block">
            Parcours<span class="text-accent">.</span>
            <img
              src="/images/trait-souligne.png"
              alt=""
              aria-hidden="true"
              class="pointer-events-none absolute left-0 top-full w-full"
            />
          </span>
        </h1>
        <p class="mt-8 max-w-2xl text-lg font-semibold">
          Product Designer UX/UI, en alternance chez EasyVista, MBA1 à Digital
          School Paris.
        </p>

        <div class="mt-6">
          <!-- Pas d'aria-label : il masquait le texte visible sans le contenir (2.5.3).
               Coins 15px et ombre portée de la maquette (comme le bouton du
               formulaire de contact). -->
          <Bouton
            fleche="aucune"
            href="/cv/audrey-garoscio-cv.pdf"
            download
            class="!rounded-[15px] drop-shadow-[0px_10px_7.5px_rgba(0,0,0,0.1),0px_4px_3px_rgba(0,0,0,0.1)]"
          >
            Télécharger le CV (PDF)
          </Bouton>
        </div>
      </div>

      <!-- Note manuscrite de la maquette, à droite du titre en xl.
           C'est LA taille de référence des citations Caveat : les pages
           contact et coulisses sont alignées dessus. -->
      <p class="hidden -rotate-[7deg] font-note text-[clamp(26px,1.88vw,36px)] leading-[normal] text-accent xl:block xl:pt-20">
        D'un univers à l'autre, un parcours guidé par le détail.
      </p>
    </div>

    <!-- La note passe sous le bouton quand la colonne de droite disparaît. -->
    <p class="mt-10 max-w-md -rotate-[7deg] font-note text-[28px] leading-[normal] text-accent xl:hidden">
      D'un univers à l'autre, un parcours guidé par le détail.
    </p>

    <div class="mt-10 border-t border-trait-2" aria-hidden="true"></div>

    <!-- « EXPERIENCE » sur la maquette : accent rétabli, pas de typo dans le
         livrable. -->
    <h2 class="mt-8 flex items-center gap-3.5 py-3.5 font-display text-xl font-semibold">
      <Icone nom="etoile" taille={38} class="shrink-0" /> EXPÉRIENCE
    </h2>
  </section>

  <!-- Sur la maquette, la timeline n'est pas centrée : elle est calée à
       gauche sous le titre EXPÉRIENCE, avec un léger retrait (~50px à 1920),
       et le contenu remplit la largeur jusqu'à la marge droite (demande
       d'Audrey : « fill », pas de colonne étroite à gauche). -->
  <div class="mx-auto max-w-[1920px] px-6 pb-20 sm:px-10 xl:px-20">
    <div class="relative xl:ml-[50px]">
    <!-- Expériences (contenu conservé ; le titre est désormais porté par le
         h2 étoilé ci-dessus) -->
    <section>
      <ol class="mt-2">
        {
          experiences.map((x, i) => (
            <li class="relative flex gap-5">
              <span class="absolute left-[5.5px] top-2 h-full w-px bg-voile/30"></span>
              <span class="relative z-10 mt-2 h-3 w-3 shrink-0 self-start rounded-full bg-accent" aria-hidden="true"></span>
              <div class={`flex-1 ${i < experiences.length - 1 ? "pb-10" : ""}`}>
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                  <h3 class="text-xl font-bold leading-snug">{x.poste}</h3>
                  <p class="text-sm text-voile">{x.dates}</p>
                </div>
                <p class="mt-1 text-base text-voile">{x.employeur}</p>
                <ul class="mt-4 space-y-2 text-base leading-relaxed">
                  {x.missions.map((m) =>
                    typeof m === "string" ? (
                      <li>{m}</li>
                    ) : (
                      <li>
                        {m.texte}{" "}
                        <a
                          href={m.lien}
                          target="_blank"
                          rel="noopener"
                          class="whitespace-nowrap font-semibold underline decoration-accent decoration-2 underline-offset-4 hover:decoration-[3px]"
                        >
                          {m.libelle}
                        </a>
                      </li>
                    ),
                  )}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Formation -->
    <section class="mt-16 border-t border-encre/10 pt-12">
      <h2 class="text-3xl font-extrabold">Formation</h2>
      <div class="mt-10 divide-y divide-encre/10">
        {
          formations.map((f) => (
            <div class="grid gap-1 py-5 first:pt-0 sm:grid-cols-[150px_1fr] sm:gap-10">
              <p class="text-sm text-voile sm:pt-0.5">{f.dates}</p>
              <div>
                <h3 class="text-lg font-bold leading-snug">{f.intitule}</h3>
                <p class="mt-0.5 text-base text-voile">{f.lieu}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Compétences UX/UI -->
    <section class="mt-16 border-t border-encre/10 pt-12">
      <h2 class="text-3xl font-extrabold">Compétences UX/UI</h2>
      <div class="mt-8 flex flex-wrap gap-2">
        {
          competences.map((c) => (
            <span class="rounded-full bg-accent/10 px-3.5 py-1 text-sm text-encre">
              {c}
            </span>
          ))
        }
      </div>
    </section>

    <!-- Outils et langues -->
    <section class="mt-16 border-t border-encre/10 pt-12">
      <h2 class="text-3xl font-extrabold">Outils et langues</h2>
      <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-3">
        {
          outils.map((o) => (
            <div>
              <h3 class="text-lg font-bold">{o.titre}</h3>
              <div class="mt-3 space-y-1 text-base leading-relaxed text-voile">
                {o.lignes.map((l) => (
                  <p>{l}</p>
                ))}
              </div>
            </div>
          ))
        }
      </div>
      <p class="note mt-10 -rotate-1">
        Ce sur quoi on me prend souvent : sens du détail, collaboration,
        pédagogie.
      </p>
    </section>
    </div>
  </div>
</Base>
