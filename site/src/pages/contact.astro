---
import Base from "../layouts/Base.astro";
import Bouton from "../components/Bouton.astro";
import Icone from "../components/Icone.astro";

// Endpoint du formulaire Formspree (les messages arrivent sur product.garoscio@gmail.com).
const formspreeEndpoint = "https://formspree.io/f/mojzoeqz";
---

<Base title="Contact — Audrey Garoscio" current="contact">
  <section class="relative mx-auto max-w-3xl px-6 pt-14 sm:px-10 sm:pt-20">
    <!-- top positif : cf. works.astro, une forme sous la nav dégradait le
         contraste des liens. La seconde forme est écartée du titre pour ne
         pas teinter le fond du H1. -->
    <div class="blob right-0 top-2 h-64 w-64 bg-accent/10" aria-hidden="true"></div>
    <!-- Retirée : à top-80 elle passait derrière les libellés « Email » et
         « LinkedIn », qui sont en text-accent. Le rouge sur son propre lavis
         tombe à 4.3:1 — c'est le seul piège de la palette à un rouge, et
         l'audit l'a trouvé ici. Une seule forme suffit à cet écran. -->

    <p class="flex items-center gap-2.5 text-xs uppercase tracking-[0.2em] text-accent">
      <Icone nom="etoile" taille={14} class="shrink-0" /> Restons en contact
    </p>
    <h1 class="mt-4 max-w-xl text-4xl font-extrabold leading-[1.05] sm:text-5xl">
      Construisons la <span class="trace">prochaine scène</span> ensemble.
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-voile">
      Disponible dès octobre 2026 pour rejoindre votre équipe. Si mon profil
      résonne avec votre projet, écrivez-moi.
    </p>

    <div class="mt-12 space-y-6 border-t border-encre/10 pt-10">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-8">
        <span class="flex items-center gap-2 text-sm text-accent sm:w-32">
          <Icone nom="email" taille={15} class="shrink-0" /> Email
        </span>
        <div>
          <a
            href="mailto:product.garoscio@gmail.com?subject=Contact%20depuis%20votre%20portfolio"
            class="text-lg transition-colors hover:font-semibold"
          >
            product.garoscio@gmail.com
          </a>
          <p class="mt-2 max-w-md text-sm leading-relaxed text-voile">
            Adresse réservée à ce portfolio : elle diffère volontairement de celle qui figure
            sur mon CV, mais les messages me parviennent tout aussi vite.
          </p>
        </div>
      </div>

      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-8">
        <span class="flex items-center gap-2 text-sm text-accent sm:w-32">
          <Icone nom="linkedin" taille={15} class="shrink-0" /> LinkedIn
        </span>
        <a
          href="https://www.linkedin.com/in/audrey-garoscio-3a4660106/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-lg transition-colors hover:font-semibold"
        >
          Audrey Garoscio<span class="sr-only"> (nouvel onglet)</span>
        </a>
      </div>

      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-8">
        <span class="text-sm text-accent sm:w-32">Où</span>
        <span class="text-lg">Noisy-le-Grand, Île-de-France</span>
      </div>
    </div>

    <!-- Formulaire de contact -->
    <div class="mt-14 border-t border-encre/10 pt-10">
      <h2 class="text-2xl font-extrabold">Glissez-moi un mot</h2>

      <form
        id="contact-form"
        action={formspreeEndpoint}
        method="POST"
        class="mt-8 space-y-6"
      >
        <!-- Anti-spam (champ invisible que les robots remplissent) -->
        <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
        <!-- Sujet de l'email reçu -->
        <input type="hidden" name="_subject" value="Nouveau message depuis le portfolio" />

        <p class="text-sm text-voile">Tous les champs sont obligatoires.</p>

        <div>
          <label for="name" class="text-sm uppercase tracking-[0.14em] text-accent">
            Nom
          </label>
          <input
            id="name"
            type="text"
            name="name"
            required
            autocomplete="name"
            class="mt-2 w-full rounded-lg border border-voile bg-transparent px-4 py-3 text-base text-encre transition-colors focus:border-encre"
          />
        </div>

        <div>
          <label for="email" class="text-sm uppercase tracking-[0.14em] text-accent">
            Email
          </label>
          <input
            id="email"
            type="email"
            name="email"
            required
            autocomplete="email"
            class="mt-2 w-full rounded-lg border border-voile bg-transparent px-4 py-3 text-base text-encre transition-colors focus:border-encre"
          />
        </div>

        <div>
          <label for="profil" class="text-sm uppercase tracking-[0.14em] text-accent">
            Vous êtes
          </label>
          <select
            id="profil"
            name="profil"
            required
            class="mt-2 w-full rounded-lg border border-voile bg-transparent px-4 py-3 text-base text-encre transition-colors focus:border-encre"
          >
            <option value="">Choisissez…</option>
            <option value="Recruteur ou recruteuse">Recruteur ou recruteuse</option>
            <option value="Professionnel du design ou du produit">
              Professionnel du design ou du produit
            </option>
            <option value="Étudiant ou étudiante">Étudiant ou étudiante</option>
            <option value="Autre">Autre</option>
          </select>
        </div>

        <div>
          <label for="message" class="text-sm uppercase tracking-[0.14em] text-accent">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-2 w-full rounded-lg border border-voile bg-transparent px-4 py-3 text-base text-encre transition-colors focus:border-encre"
          ></textarea>
        </div>

        <Bouton type="submit">Envoyer le message</Bouton>

        <!-- Messages de retour.
             role="status" / role="alert" : sans eux, la bascule de la classe
             `hidden` était totalement muette pour un lecteur d'écran (4.1.3).
             Les deux <p> restent dans le DOM en permanence, sinon la région
             live ne serait pas observée au moment de l'insertion. -->
        <p id="form-success" class="hidden text-sm text-encre" role="status">
          Merci, votre message est bien parti. Je vous réponds très vite.
        </p>
        <p id="form-error" class="hidden text-sm text-accent" role="alert">
          Oups, l'envoi a échoué. Réessayez, ou écrivez-moi directement à
          product.garoscio@gmail.com.
        </p>
      </form>
    </div>

    <p class="note mt-16 -rotate-1">
      Une idée en coulisses, un projet à mettre en scène ? Parlons-en.
    </p>
  </section>

  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const success = document.getElementById("form-success");
    const error = document.getElementById("form-error");

    if (form && success && error) {
      // On ne désactive PAS le bouton pendant l'envoi : il porte le focus au
      // moment du submit, et le désactiver renverrait le focus sur <body>,
      // éjectant silencieusement l'utilisateur en haut de page. Un verrou
      // simple suffit à empêcher le double envoi.
      let envoiEnCours = false;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (envoiEnCours) return;
        envoiEnCours = true;

        success.classList.add("hidden");
        error.classList.add("hidden");
        form.setAttribute("aria-busy", "true");

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
          });

          if (response.ok) {
            form.reset();
            success.classList.remove("hidden");
          } else {
            error.classList.remove("hidden");
          }
        } catch {
          error.classList.remove("hidden");
        } finally {
          form.removeAttribute("aria-busy");
          envoiEnCours = false;
        }
      });
    }
  </script>
</Base>
