---
import Base from "../layouts/Base.astro";
import Bouton from "../components/Bouton.astro";
import Icone from "../components/Icone.astro";

// Endpoint du formulaire Formspree (les messages arrivent sur product.garoscio@gmail.com).
const formspreeEndpoint = "https://formspree.io/f/mojzoeqz";

// Page « Le guichet » — maquette Figma CV-Portfolio, node 64:2557.
// Deux panneaux sur lavis lie-de-vin/10 : infos de contact à gauche
// (photo bulles + email / téléphone / adresse), formulaire à droite.

// Style commun des champs (maquette « Input » : fond blanc, coins 10px,
// bordure gris clair #ebebeb, ombre portée). Demande explicite d'Audrey :
// la bordure par défaut reste celle de la maquette (border-trait) — la
// limite du champ est portée par l'aplat blanc + l'ombre, la bordure se
// renforce au survol puis au focus.
const champ =
  "w-full rounded-[10px] border border-trait bg-white px-5 py-3 text-base text-encre shadow-[3px_2px_7px_0_rgba(0,0,0,0.36)] transition-colors placeholder:text-voile hover:border-voile-fort focus:border-encre";

// Étiquettes : la maquette les pose en lie de vin sur le lavis accent/10,
// mais le rouge sur son propre lavis tombe à 4.3:1 (le piège documenté dans
// global.css, trouvé par l'audit… sur cette page). accent-bord (#4b151d,
// la profondeur du même rouge — pas un second rouge) tient à 12:1.
const etiquette = "text-lg font-semibold text-accent-bord";

const infos = [
  {
    label: "Email",
    valeur: "product.garoscio@gmail.com",
    href: "mailto:product.garoscio@gmail.com?subject=Contact%20depuis%20votre%20portfolio",
    icone: "/images/figma-icon-email-35.svg",
    bordure: true,
  },
  {
    // ⚠ Numéro factice repris de la maquette — à remplacer par le vrai
    // (ou à retirer) avant mise en ligne.
    label: "Téléphone",
    valeur: "+33 6 12 34 56 78",
    href: "tel:+33612345678",
    icone: "/images/figma-icon-telephone.svg",
    bordure: true,
  },
  {
    label: "Adresse",
    valeur: "Noisy-le-Grand, Île-de-France",
    icone: "/images/figma-icon-adresse.svg",
    bordure: false,
  },
];
---

<Base title="Contact — Audrey Garoscio" current="contact">
  <section class="mx-auto max-w-[1920px] px-6 pb-16 pt-8 sm:px-10 xl:px-20">
    <!-- En-tête « Le guichet ». Grille à deux colonnes en xl : le titre à
         gauche, la note manuscrite et son doodle à droite — sans absolu,
         pour que rien ne se chevauche à 1280. -->
    <div class="grid gap-8 xl:grid-cols-[1fr_clamp(380px,29.5vw,565px)] xl:items-start">
      <div>
        <p class="flex items-center gap-3.5 py-5 font-display text-xl font-semibold uppercase">
          <Icone nom="etoile" taille={38} class="shrink-0" /> Le guichet
        </p>
        <!-- Tailles proportionnelles (clamp, comme l'accueil) : la maquette
             est dessinée à 1920 ; en px figés, à 1280 le titre passait sur
             deux lignes et la citation paraissait disproportionnée. -->
        <h1 class="mt-2 font-display text-4xl font-bold leading-[normal] sm:text-5xl lg:text-[clamp(40px,3.34vw,64px)]">
          Disponible dès <span class="text-accent">octobre 2026</span>
        </h1>
        <p class="mt-5 max-w-2xl text-lg font-semibold">
          Si mon profil résonne avec votre projet, écrivez-moi.
        </p>
      </div>

      <!-- La citation n'utilise pas la classe .note : sa taille fixe
           (1.35rem, hors layer) écrase les utilitaires text-[…] et rendait
           le texte trop petit. Ici on pose la fonte et les 40px à la main. -->
      <div class="hidden xl:block xl:pt-8">
        <p class="-rotate-3 font-note text-[clamp(28px,2.09vw,40px)] font-bold leading-[1.15] text-accent">
          Une idée en coulisses, un projet à mettre en scène ? Parlons-en.
        </p>
        <!-- Le doodle est volontairement aplati (228×40 à 1920, object-fill) :
             c'est le cadrage écrasé de la maquette, pas le ratio du PNG. -->
        <img
          src="/images/figma-contact-doodle.png"
          alt=""
          aria-hidden="true"
          width="464"
          height="194"
          class="ml-auto mr-2 mt-5 h-[clamp(28px,2.09vw,40px)] w-[clamp(160px,11.9vw,228px)] -rotate-[10deg]"
        />
      </div>
    </div>

    <!-- Les deux panneaux -->
    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <!-- Infos de contact -->
      <div class="flex flex-col gap-3.5 rounded-[20px] bg-accent/10 p-5">
        <!-- Illustration décorative (bulles de dialogue) : le sens est porté
             par les infos en dessous. -->
        <!-- h-[240px] + flex-1 : la hauteur « naturelle » de la photo est
             basse, c'est donc le FORMULAIRE qui fixe la hauteur de la rangée
             et la photo grandit pour remplir. En hauteur auto, la photo
             (plein cadre) dépassait le formulaire et creusait un grand vide
             sous « Envoyer le message ». -->
        <img
          src="/images/figma-contact-bulles.jpg"
          alt=""
          width="1542"
          height="1028"
          loading="lazy"
          class="h-[240px] w-full flex-1 rounded-[10px] object-cover"
        />

        <ul class="flex flex-col pt-6">
          {
            infos.map((info) => (
              <li
                class:list={[
                  "flex items-center gap-3 py-2",
                  info.bordure && "border-b border-voile",
                ]}
              >
                <img src={info.icone} alt="" aria-hidden="true" class="w-[33px] shrink-0" />
                <div class="flex flex-col gap-1 py-2">
                  <p class="text-lg leading-snug">{info.label}</p>
                  {info.href ? (
                    <a
                      href={info.href}
                      class="font-semibold leading-snug underline-offset-4 decoration-accent decoration-2 hover:underline"
                    >
                      {info.valeur}
                    </a>
                  ) : (
                    <p class="font-semibold leading-snug">{info.valeur}</p>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Formulaire -->
      <div class="rounded-[20px] bg-accent/10 px-5 py-8">
        <form
          id="contact-form"
          action={formspreeEndpoint}
          method="POST"
          enctype="multipart/form-data"
          class="flex flex-col gap-8"
        >
          <!-- Anti-spam (champ invisible que les robots remplissent) -->
          <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
          <!-- Sujet de l'email reçu -->
          <input type="hidden" name="_subject" value="Nouveau message depuis le portfolio" />

          <div class="grid gap-6 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label for="nom" class={etiquette}>Nom</label>
              <input
                id="nom"
                type="text"
                name="nom"
                required
                autocomplete="family-name"
                placeholder="Entrez votre nom"
                class={champ}
              />
            </div>
            <div class="flex flex-col gap-2">
              <label for="prenom" class={etiquette}>Prénom</label>
              <input
                id="prenom"
                type="text"
                name="prenom"
                required
                autocomplete="given-name"
                placeholder="Entrez votre prénom"
                class={champ}
              />
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label for="email" class={etiquette}>Email</label>
            <input
              id="email"
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="votre@email.com"
              class={champ}
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="profil" class={etiquette}>Vous êtes ?</label>
            <div class="relative">
              <select id="profil" name="profil" required class:list={[champ, "appearance-none pr-12"]}>
                <option value="">Sélectionnez…</option>
                <option value="Recruteur ou recruteuse">Recruteur ou recruteuse</option>
                <option value="Professionnel du design ou du produit">
                  Professionnel du design ou du produit
                </option>
                <option value="Étudiant ou étudiante">Étudiant ou étudiante</option>
                <option value="Autre">Autre</option>
              </select>
              <svg
                class="pointer-events-none absolute inset-y-0 right-4 my-auto size-5 text-voile-fort"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label for="message" class="sr-only">Message</label>
            <textarea
              id="message"
              name="message"
              required
              maxlength="1000"
              placeholder="Comment puis-je vous aider ?"
              aria-describedby="compteur-caracteres"
              class:list={[champ, "h-[223px] resize-y"]}></textarea>

            <div class="flex flex-wrap items-center justify-between gap-3">
              <!-- Pièce jointe : l'input est visuellement masqué, l'étiquette
                   sert de cible ; le halo de focus est reporté sur elle. -->
              <label
                class="flex cursor-pointer items-center gap-3 text-sm text-voile-fort transition-colors hover:font-semibold hover:text-encre has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-4 has-[:focus-visible]:outline-encre"
              >
                <input
                  id="piece-jointe"
                  type="file"
                  name="piece-jointe"
                  accept=".jpg,.jpeg,.png,.pdf"
                  class="sr-only"
                />
                <img
                  src="/images/figma-icon-trombone.svg"
                  alt=""
                  aria-hidden="true"
                  class="h-[22px] w-auto shrink-0"
                />
                Joindre un fichier (JPG, PNG, PDF 5&nbsp;Mo max)
              </label>
              <p id="compteur-caracteres" class="text-sm text-voile">0/1000 caractères</p>
            </div>
            <p id="fichier-info" class="text-sm text-encre" role="status"></p>
          </div>

          <!-- Coins 15px de la maquette (le primaire du site est rounded-full
               ailleurs) : le ! est nécessaire pour trancher le conflit avec
               la classe du composant. -->
          <Bouton type="submit" fleche="aucune" class="w-full justify-center !rounded-[15px]">
            Envoyer le message
          </Bouton>

          <!-- Messages de retour.
               role="status" / role="alert" : sans eux, la bascule de la classe
               `hidden` était totalement muette pour un lecteur d'écran (4.1.3).
               Les deux <p> restent dans le DOM en permanence, sinon la région
               live ne serait pas observée au moment de l'insertion.
               L'erreur est en accent-bord, pas en accent : rouge sur son
               propre lavis = 4.3:1 (cf. global.css). -->
          <p id="form-success" class="hidden text-sm text-encre" role="status">
            Merci, votre message est bien parti. Je vous réponds très vite.
          </p>
          <p id="form-error" class="hidden text-sm font-semibold text-accent-bord" role="alert">
            Oups, l'envoi a échoué. Réessayez, ou écrivez-moi directement à
            product.garoscio@gmail.com.
          </p>
        </form>
      </div>
    </div>

    <!-- La note manuscrite passe sous les panneaux quand la colonne de
         droite disparaît (en dessous de xl). -->
    <div class="mt-10 xl:hidden">
      <p class="max-w-md -rotate-2 font-note text-[32px] font-bold leading-[1.15] text-accent">
        Une idée en coulisses, un projet à mettre en scène ? Parlons-en.
      </p>
      <img
        src="/images/figma-contact-doodle.png"
        alt=""
        aria-hidden="true"
        width="464"
        height="194"
        class="mt-4 h-[34px] w-[190px] -rotate-[10deg]"
      />
    </div>
  </section>

  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const success = document.getElementById("form-success");
    const error = document.getElementById("form-error");

    // Compteur de caractères du message (maquette « 87/1000 caractères »).
    const message = document.getElementById("message") as HTMLTextAreaElement | null;
    const compteur = document.getElementById("compteur-caracteres");
    if (message && compteur) {
      const majCompteur = () => {
        compteur.textContent = `${message.value.length}/1000 caractères`;
      };
      message.addEventListener("input", majCompteur);
      majCompteur();
    }

    // Pièce jointe : contrôle de la taille (5 Mo) et rappel du fichier choisi.
    const fichier = document.getElementById("piece-jointe") as HTMLInputElement | null;
    const fichierInfo = document.getElementById("fichier-info");
    if (fichier && fichierInfo) {
      fichier.addEventListener("change", () => {
        const f = fichier.files?.[0];
        if (!f) {
          fichierInfo.textContent = "";
          return;
        }
        if (f.size > 5 * 1024 * 1024) {
          fichier.value = "";
          fichierInfo.textContent =
            "Ce fichier dépasse 5 Mo : merci d'en choisir un plus léger.";
          return;
        }
        fichierInfo.textContent = `Fichier joint : ${f.name}`;
      });
    }

    if (form && success && error) {
      // On ne désactive PAS le bouton pendant l'envoi : il porte le focus au
      // moment du submit, et le désactiver renverrait le focus sur <body>,
      // éjectant silencieusement l'utilisateur en haut de page. Un verrou
      // simple suffit à empêcher le double envoi.
      let envoiEnCours = false;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (envoiEnCours) return;
        envoiEnCours = true;

        success.classList.add("hidden");
        error.classList.add("hidden");
        form.setAttribute("aria-busy", "true");

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
          });

          if (response.ok) {
            form.reset();
            if (fichierInfo) fichierInfo.textContent = "";
            if (compteur) compteur.textContent = "0/1000 caractères";
            success.classList.remove("hidden");
          } else {
            error.classList.remove("hidden");
          }
        } catch {
          error.classList.remove("hidden");
        } finally {
          form.removeAttribute("aria-busy");
          envoiEnCours = false;
        }
      });
    }
  </script>
</Base>
