---
import Base from "../layouts/Base.astro";
import Icone from "../components/Icone.astro";

const saison = [
  {
    href: "/works/pool-party",
    titre: "Pool Party",
    sous: "Marketplace P2P de location de piscines",
    note: "Du cadrage stratégique à la maquette livrable. Six mois, en autonomie.",
    role: "Cheffe de projet, de bout en bout",
    contexte: "Projet de fin de cycle, MBA",
    image: "/images/poolparty-page-daccueil-maquette-page-daccueil-ordinateur.jpg",
  },
  {
    href: "/works/sumo-tournament",
    titre: "Sumo Tournament",
    sous: "Site événementiel et back-office",
    note: "Le projet où le design rencontre le code pour de vrai. Conception et mise en production.",
    role: "Conception et mise en production",
    contexte: "Projet d'équipe",
    image: "/images/sumo-home.png",
  },
  {
    href: "/works/pool-and-splash",
    titre: "Pool & Splash",
    sous: "Refonte UI, direction kidkulting",
    note: "Oser un ton joyeux là où tout le secteur joue le sérieux.",
    role: "Direction artistique et UI",
    contexte: "Refonte",
    image: "/images/homepage.png",
  },
];

const esquisses = [
  {
    href: "/works/golyeo-korea",
    titre: "Golyeo Korea",
    note:
      "Exploration d'identité pour un restaurant coréen. Deux directions : une mignonne et pastel inspirée du design kawaii coréen, une plus traditionnelle et sobre. Recherche de logo, palette, carte de visite.",
    cover: "/images/golyeo-logo-1.jpg",
  },
];
---

<Base title="Projets — Audrey Garoscio" current="works">
  <!-- En-tête -->
  <section class="relative mx-auto max-w-6xl px-6 pt-10 sm:px-10 sm:pt-16">
    <!-- Calée sous la nav et dans la largeur : cf. les deux règles d'usage
         de .blob dans global.css. Elle déborde librement vers le bas. -->
    <div class="blob right-0 top-4 h-72 w-72 bg-accent/10" aria-hidden="true"></div>

    <header class="max-w-2xl">
      <p class="flex items-center gap-2.5 text-xs uppercase tracking-[0.2em] text-accent">
        <Icone nom="etoile" taille={14} class="shrink-0" /> À l'affiche
      </p>
      <h1 class="mt-4 text-5xl font-extrabold leading-[1.03] sm:text-6xl">
        Projets
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-voile">
        Trois projets menés de bout en bout. Chacun avec son sujet, son rythme,
        ses contraintes.
      </p>
    </header>
  </section>

  <!-- La saison -->
  <section class="mx-auto max-w-6xl px-6 pt-14 sm:px-10">
    <div class="space-y-10">
      {
        /* Motif "stretched link" : seul le titre est un lien, mais son ::after
           couvre toute la carte, qui reste donc cliquable en entier. Un <a>
           englobant titre + note + "Lire l'étude" + l'alt de l'image ferait un
           nom de lien long d'un paragraphe (WCAG 2.4.4). L'image devient
           décorative (alt=""), le titre la nomme déjà. */
        saison.map((p, i) => (
          <article class="group relative overflow-hidden rounded-[28px] rounded-tl-[4px] border border-encre/10 transition-colors hover:border-encre/25">
            <div
              class:list={[
                "grid grid-cols-1 lg:grid-cols-[1fr_1.1fr]",
                i % 2 === 1 && "lg:grid-cols-[1.1fr_1fr]",
              ]}
            >
              <div
                class:list={[
                  "order-2 bg-white/50 p-8 sm:p-10",
                  i % 2 === 1 ? "lg:order-2" : "lg:order-1",
                ]}
              >
                <div class="flex items-center gap-3">
                  <span class="text-sm font-bold text-accent" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="text-xs uppercase tracking-[0.18em] text-accent">
                    {p.contexte}
                  </span>
                </div>

                <h2 class="mt-4 text-3xl font-extrabold leading-tight sm:text-4xl">
                  <a href={p.href} class="after:absolute after:inset-0 after:content-['']">
                    {p.titre}
                  </a>
                </h2>
                <p class="mt-2 text-base text-voile">{p.sous}</p>
                <p class="mt-5 max-w-sm text-base leading-relaxed">{p.note}</p>

                <p class="mt-7 border-t border-encre/10 pt-5 text-sm">
                  <span class="text-accent">Rôle</span>
                  <span class="ml-3 text-encre">{p.role}</span>
                </p>

                <span class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-encre" aria-hidden="true">
                  Lire l'étude
                  <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
                </span>
              </div>

              <!-- Même aplat pour les trois projets : une couleur par carte ne
                   distinguait rien que le titre ne dise déjà. -->
              <div
                class:list={[
                  "order-1 flex items-center justify-center bg-accent/10 p-8",
                  i % 2 === 1 ? "lg:order-1" : "lg:order-2",
                ]}
              >
                <!-- Cadrage haut : ces maquettes sont des captures de page
                     entière, très hautes. Cf. même choix sur la home. -->
                <img
                  src={p.image}
                  alt=""
                  loading="lazy"
                  class="h-[360px] w-full rounded-[4px] object-cover object-top shadow-[0_18px_45px_-24px_rgb(30_28_28/0.5)]"
                />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Esquisses -->
  <section class="mx-auto max-w-6xl px-6 pt-24 sm:px-10 sm:pt-32">
    <header class="max-w-xl border-t border-encre/10 pt-12">
      <p class="text-xs uppercase tracking-[0.2em] text-accent">Plus libre</p>
      <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl">Esquisses</h2>
      <p class="mt-5 text-lg leading-relaxed text-voile">
        Explorations plus libres. Identités, pistes graphiques, projets en
        recherche.
      </p>
    </header>

    <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2">
      {
        esquisses.map((e) => (
          <article class="group relative overflow-hidden rounded-[24px] rounded-tl-[4px] border border-encre/10 transition-colors hover:border-encre/25">
            <div class="bg-accent/10 p-6">
              <img
                src={e.cover}
                alt=""
                loading="lazy"
                class="aspect-[4/3] w-full rounded-[4px] object-contain"
              />
            </div>
            <div class="bg-white/50 p-6">
              <h3 class="text-xl font-bold">
                <a href={e.href} class="after:absolute after:inset-0 after:content-['']">
                  {e.titre}
                </a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-voile">{e.note}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-encre" aria-hidden="true">
                Voir l'esquisse
                <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
              </span>
            </div>
          </article>
        ))
      }

      {/* Emplacement libre pour d'autres esquisses */}
      <article class="flex items-center justify-center rounded-[24px] rounded-tl-[4px] border border-dashed border-encre/20 p-6">
        <p class="note text-center">Autres explorations à venir</p>
      </article>
    </div>
  </section>
</Base>
