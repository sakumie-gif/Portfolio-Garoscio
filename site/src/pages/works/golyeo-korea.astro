---
import CaseStudy from "../../layouts/CaseStudy.astro";

// Chaque piste a son propre alt : un alt identique répété cinq fois ne
// permettait pas de les distinguer à l'écoute (WCAG 1.1.1). Le motif commun
// est un renard à neuf queues tenant un bol de nouilles, en bordeaux sur ivoire.
const logos = [
  {
    src: "/images/golyeo-logo-1.jpg",
    alt: "Piste 1 : le renard cerné d'un filet circulaire fin, GOLYEO en arc au-dessus, KOREA en arc en dessous, un losange plein de chaque côté.",
  },
  {
    src: "/images/golyeo-logo-3.jpg",
    alt: "Piste 2 : la même composition débarrassée du cercle, les deux arcs de texte tenant seuls, losanges écartés sur les bords.",
  },
  {
    src: "/images/golyeo-logo-4.jpg",
    alt: "Piste 3 : version médaillon à double filet, le texte courant sur l'anneau et le renard enfermé dans le cercle intérieur.",
  },
  {
    src: "/images/golyeo-logo-5.jpg",
    alt: "Piste 4 : variante sans cercle, queues déployées plus largement et bol de nouilles ramené plus bas.",
  },
  {
    src: "/images/golyeo-logo-2.jpg",
    alt: "Piste 5, direction pastel : tout le logo en orange abricot, filet circulaire épais, tracé du renard plus détaillé, losanges ramenés à l'intérieur du cercle.",
  },
];
---

<CaseStudy
  title="Golyeo Korea"
  kicker="Esquisse — identité visuelle"
  didascalie="Exploration d'identité pour un restaurant coréen traditionnel."
  accent="corail"
>
  <h2>L'exploration</h2>
  <p>
    Recherche d'identité visuelle pour Golyeo Korea, un restaurant coréen
    traditionnel. L'objectif : trouver un univers qui raconte à la fois
    l'authenticité de la cuisine et une certaine douceur, sans tomber dans le
    cliché.
  </p>
  <p>
    Deux directions explorées : l'une mignonne et pastel, inspirée du design
    kawaii coréen ; l'autre plus traditionnelle et sobre. Le travail a couvert le
    logo, la palette et la carte de visite.
  </p>

  <figure>
    <img src="/images/golyeo-photo.jpg" alt="Mise en situation de l'identité Golyeo Korea" loading="lazy" />
    <figcaption>Mise en situation de l'univers Golyeo Korea.</figcaption>
  </figure>

  <h2>Les pistes de logo</h2>
  <div class="my-10 grid grid-cols-2 gap-4 sm:grid-cols-3">
    {logos.map((logo) => (
      <img src={logo.src} alt={logo.alt} loading="lazy" class="w-full rounded-[2px]" />
    ))}
  </div>

  <h2>La carte de visite</h2>
  <figure>
    <img
      src="/images/golyeo-carte.png"
      alt="Carte de visite Golyeo Korea"
      loading="lazy"
      class="mx-auto max-w-[260px]"
    />
    <figcaption>Carte de visite, direction traditionnelle.</figcaption>
  </figure>
</CaseStudy>
