---
// Header repris de la maquette Figma « CV-Portfolio » (node 64:1609) :
// nom en Poppins Bold + tagline manuscrite lie-de-vin, liens À l'affiche /
// Parcours / Metteur en scène / Contact, filet bas.
//
// Bilingue (demande d'Audrey du 20/07/2026) : prop `lang` ("fr" par défaut,
// "en" pour les pages miroirs sous /en/) + petit sélecteur FR/EN en bout de
// nav. Le sélecteur calcule l'URL équivalente dans l'autre langue à partir
// du chemin courant (mêmes slugs des deux côtés, préfixe /en).
const { current = "", lang = "fr" } = Astro.props;
const en = lang === "en";

const libelles = {
  fr: [
    { href: "/works", label: "À l'affiche", key: "works" },
    { href: "/parcours", label: "Parcours", key: "parcours" },
    { href: "/coulisses", label: "Metteur en scène", key: "coulisses" },
    { href: "/contact", label: "Contact", key: "contact" },
  ],
  en: [
    { href: "/en/works", label: "Now Showing", key: "works" },
    { href: "/en/parcours", label: "Journey", key: "parcours" },
    { href: "/en/coulisses", label: "Director", key: "coulisses" },
    { href: "/en/contact", label: "Contact", key: "contact" },
  ],
};
const links = libelles[en ? "en" : "fr"];

// URL équivalente dans l'autre langue : même chemin, avec ou sans /en.
const chemin = Astro.url.pathname.replace(/\/$/, "") || "/";
const hrefFr = en ? chemin.replace(/^\/en/, "") || "/" : chemin;
const hrefEn = en ? chemin : chemin === "/" ? "/en/" : `/en${chemin}`;
---

<header class="border-b border-trait-2">
  <nav
    class="mx-auto flex max-w-[1920px] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-[25px] sm:px-10 xl:px-20"
    aria-label={en ? "Main navigation" : "Navigation principale"}
  >
    <a
      href={en ? "/en/" : "/"}
      class="flex items-baseline gap-4"
      aria-label={en ? "Audrey Garoscio — back to home" : "Audrey Garoscio — retour à l'accueil"}
    >
      <span class="font-display text-xl font-bold text-encre sm:text-[28px]">Audrey Garoscio</span>
      <span class="note hidden text-2xl font-bold sm:inline sm:text-[32px]" aria-hidden="true">
        Product Design UX/UI
      </span>
    </a>
    <!-- Sur grand écran (≥1860px), le groupe de liens démarre au bord gauche
         du portrait de l'accueil (photo à 38,7 % du cadre 1920) : largeur
         fixée à 37,7 % du contenu de la nav ≈ 663px à 1920, liens calés à
         gauche. En dessous (dont le 1280 d'Audrey), rien ne change. -->
    <ul class="flex flex-wrap items-center gap-[14px] min-[1860px]:w-[37.7%] min-[1860px]:justify-start">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "block rounded-[30px] px-5 py-2 text-base text-encre transition-colors hover:font-semibold",
                current === link.key && "font-semibold",
              ]}
              aria-current={current === link.key ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <!-- Petit sélecteur de langue : la langue active est en semi-bold
           (comme le lien de page courante), l'autre passe en semi-bold au
           survol — règle hover du site. -->
      <li class="flex items-center gap-1 pl-1 text-base text-encre">
        <a
          href={hrefFr}
          lang="fr"
          hreflang="fr"
          aria-label="Version française"
          aria-current={!en ? "true" : undefined}
          class:list={["rounded-[30px] px-1 py-2 transition-colors", !en ? "font-semibold" : "hover:font-semibold"]}
        >
          FR
        </a>
        <span aria-hidden="true">/</span>
        <a
          href={hrefEn}
          lang="en"
          hreflang="en"
          aria-label="English version"
          aria-current={en ? "true" : undefined}
          class:list={["rounded-[30px] px-1 py-2 transition-colors", en ? "font-semibold" : "hover:font-semibold"]}
        >
          EN
        </a>
      </li>
    </ul>
  </nav>
</header>
