---
const { current = "" } = Astro.props;
// Libellés en français : un recruteur doit comprendre où cliquer sans
// décoder un vocabulaire de scène. Les routes restent inchangées pour ne
// casser ni les liens existants ni le référencement.
const links = [
  { href: "/works", label: "Projets", key: "works" },
  { href: "/about", label: "À propos", key: "about" },
  { href: "/parcours", label: "Parcours", key: "parcours" },
  { href: "/contact", label: "Contact", key: "contact" },
];
---

<header class="w-full">
  <!-- flex-wrap : à 390px, nom + 4 liens font 397px et faisaient scroller la
       page horizontalement. Les liens passent à la ligne plutôt que déborder. -->
  <nav
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-6 sm:px-10"
    aria-label="Navigation principale"
  >
    <a
      href="/"
      class="group flex items-baseline gap-2.5 transition-colors"
      aria-label="Audrey Garoscio — retour à l'accueil"
    >
      <span class="text-base font-extrabold tracking-tight text-encre sm:text-lg">
        Audrey Garoscio
      </span>
      <span class="note hidden text-base sm:inline" aria-hidden="true">
        Product Designer
      </span>
    </a>

    <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm sm:gap-x-8">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "-my-1 block py-1 transition-colors hover:font-semibold hover:text-encre",
                current === link.key ? "font-semibold text-encre" : "text-voile",
              ]}
              aria-current={current === link.key ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
