---
const { current = "" } = Astro.props;
const links = [
  { href: "/works", label: "Works", key: "works" },
  { href: "/about", label: "About", key: "about" },
  { href: "/contact", label: "Contact", key: "contact" },
];
---

<header class="w-full">
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between px-6 py-7 sm:px-10"
    aria-label="Navigation principale"
  >
    <a
      href="/"
      class="font-display text-xl font-semibold tracking-tight text-encre transition-colors hover:text-voile"
      aria-label="Retour à l'accueil"
    >
      Garoscio<span class="text-bordeaux">.</span>
    </a>

    <ul class="flex items-center gap-7 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "transition-colors hover:font-semibold hover:text-encre",
                current === link.key ? "text-encre" : "text-voile",
              ]}
              aria-current={current === link.key ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
