---
import ThemeToggle from "./ThemeToggle.astro";
const { current = "" } = Astro.props;
// `lang` marque les intitulés anglais dans un document déclaré fr, pour que la
// synthèse vocale ne les prononce pas à la française (WCAG 3.1.2 / RGAA 8.7).
const links = [
  { href: "/works", label: "Works", key: "works", lang: "en" },
  { href: "/about", label: "About", key: "about", lang: "en" },
  { href: "/parcours", label: "Parcours", key: "parcours" },
  { href: "/contact", label: "Contact", key: "contact" },
];
---

<header class="w-full">
  <nav
    class="mx-auto flex max-w-5xl items-start justify-between px-6 py-7 sm:px-10"
    aria-label="Navigation principale"
  >
    <a
      href="/"
      class="font-display text-xl font-semibold tracking-tight text-encre transition-colors hover:text-voile"
      aria-label="Garoscio — retour à l'accueil"
    >
      Garoscio<span class="text-accent" aria-hidden="true">.</span>
    </a>

    <div class="flex flex-col items-end gap-3">
      <ul class="flex items-center gap-7 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                lang={link.lang}
                class:list={[
                  "-my-1 block py-1 transition-colors hover:font-semibold hover:text-encre",
                  current === link.key ? "text-encre" : "text-voile",
                ]}
                aria-current={current === link.key ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
