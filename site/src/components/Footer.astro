---
// Footer repris de la maquette Figma « CV-Portfolio » (node 64:3792) :
// bande rose pâle pleine largeur, titre Poppins Bold souligné du trait
// manuscrit, contacts, liens légaux, note Caveat, barre copyright.
// Bilingue : prop `lang` ("fr" par défaut, "en" pour les pages /en/).
const { lang = "fr" } = Astro.props;
const en = lang === "en";
const year = new Date().getFullYear();

const t = en
  ? {
      accroche1: "L",
      accroche2: "et's keep in touch!",
      titre: "Let's talk about your next project!",
      nouvelOnglet: " (new tab)",
      mentions: "Legal notice",
      confidentialite: "Privacy policy",
      hrefMentions: "/en/mentions-legales",
      note1: "Design with purpose,",
      note2: "deliver with impact.",
    }
  : {
      accroche1: "R",
      accroche2: "estons en contact !",
      titre: "Parlons de votre prochain projet !",
      nouvelOnglet: " (nouvel onglet)",
      mentions: "Mentions légales",
      confidentialite: "Politique de confidentialité",
      hrefMentions: "/mentions-legales",
      note1: "Concevoir avec sens,",
      note2: "livrer avec impact.",
    };
---

<footer class="border-t border-[#fbf9f7] bg-[rgba(188,134,128,0.1)]">
  <div class="mx-auto flex max-w-[1920px] flex-col gap-5 px-6 py-5 sm:px-10 xl:px-20">
    <!-- La rangée titre / note / liens légaux ne passe qu'à partir de xl :
         en dessous, la note Caveat chevauchait le titre. -->
    <div class="relative flex flex-col items-start justify-between gap-8 xl:min-h-[182px] xl:flex-row xl:items-end">
      <div class="flex flex-col gap-8 self-stretch xl:justify-between">
        <div class="flex flex-col gap-2.5">
          <p class="text-lg font-semibold">
            <span class="text-accent">{t.accroche1}</span><span class="text-encre">{t.accroche2}</span>
          </p>
          <p class="relative font-display text-3xl font-bold text-encre sm:text-[40px]">
            {t.titre}
            <img
              src="/images/trait-souligne.png"
              alt=""
              aria-hidden="true"
              class="pointer-events-none absolute left-[40%] top-full w-[64%] max-w-[460px]"
            />
          </p>
        </div>
        <ul class="flex flex-col gap-[14px]">
          <li>
            <a
              href="mailto:product.garoscio@gmail.com"
              class="flex items-center gap-2 text-sm text-voile-fort transition-colors hover:font-semibold hover:text-encre"
            >
              <img src="/images/figma-icon-mail.svg" alt="" aria-hidden="true" class="size-6" />
              product.garoscio@gmail.com
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/audrey-garoscio-3a4660106/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm text-voile-fort transition-colors hover:font-semibold hover:text-encre"
            >
              <img src="/images/figma-icon-linkedin.svg" alt="" aria-hidden="true" class="size-6" />
              linkedin.com/in/audrey-garoscio<span class="sr-only">{t.nouvelOnglet}</span>
            </a>
          </li>
        </ul>
      </div>

      <p class="note -rotate-3 text-3xl font-normal sm:text-[36px] xl:absolute xl:right-[10%] xl:top-4">
        {t.note1}<br />{t.note2}
      </p>

      <div class="flex flex-wrap items-center gap-[14px]">
        <a
          href={t.hrefMentions}
          class="rounded-[30px] px-5 py-2 text-base text-encre transition-colors hover:font-semibold"
        >
          {t.mentions}
        </a>
        <a
          href={t.hrefMentions}
          class="rounded-[30px] px-5 py-2 text-base text-encre transition-colors hover:font-semibold"
        >
          {t.confidentialite}
        </a>
      </div>
    </div>

    <div class="flex flex-col items-center justify-center border-t border-trait-2 pt-5">
      <p class="text-xs text-voile-fort">© {year} Garoscio Audrey — Product Designer UX/UI</p>
    </div>
  </div>
</footer>
