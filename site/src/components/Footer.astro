  <div class="flex flex-col gap-4 border-t border-voile/25 pt-8 text-sm text-voile sm:flex-row sm:items-center sm:justify-between">
    <p class="font-display italic">
      Audrey Garoscio, <span lang="en">Product Designer</span>
    </p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <a href="mailto:product.garoscio@gmail.com" class="-my-1 py-1 transition-colors hover:font-semibold hover:text-encre">
        Email
      </a>
      <a
        href="https://www.linkedin.com/in/audrey-garoscio-3a4660106/"
        target="_blank"
        rel="noopener noreferrer"
        class="-my-1 py-1 transition-colors hover:font-semibold hover:text-encre"
      >
        LinkedIn<span class="sr-only"> (nouvel onglet)</span>
      </a>
      <a href="/mentions-legales" class="-my-1 py-1 transition-colors hover:font-semibold hover:text-encre">
        Mentions légales
