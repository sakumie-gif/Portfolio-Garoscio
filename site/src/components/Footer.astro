---
// Footer repris de la maquette Figma « CV-Portfolio » (node 64:3792) :
// bande rose pâle pleine largeur, titre Poppins Bold souligné du trait
// manuscrit, contacts, liens légaux, note Caveat, barre copyright.
const year = new Date().getFullYear();
---

<footer class="border-t border-[#fbf9f7] bg-[rgba(188,134,128,0.1)]">
  <div class="mx-auto flex max-w-[1920px] flex-col gap-5 px-6 py-5 sm:px-10 xl:px-20">
    <div class="relative flex flex-col items-start justify-between gap-8 lg:min-h-[182px] lg:flex-row lg:items-end">
      <div class="flex flex-col gap-8 self-stretch lg:justify-between">
        <div class="flex flex-col gap-2.5">
          <p class="text-lg font-semibold">
            <span class="text-accent">R</span><span class="text-encre">estons en contact !</span>
          </p>
          <p class="relative font-display text-3xl font-bold text-encre sm:text-[40px]">
            Parlons de votre prochain projet !
            <img
              src="/images/trait-souligne.png"
              alt=""
              aria-hidden="true"
              class="pointer-events-none absolute left-[40%] top-full w-[64%] max-w-[460px]"
            />
          </p>
        </div>
        <ul class="flex flex-col gap-[14px]">
          <li>
            <a
              href="mailto:product.garoscio@gmail.com"
              class="flex items-center gap-2 text-sm text-voile-fort transition-colors hover:font-semibold hover:text-encre"
            >
              <img src="/images/figma-icon-mail.svg" alt="" aria-hidden="true" class="size-6" />
              product.garoscio@gmail.com
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/audrey-garoscio-3a4660106/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm text-voile-fort transition-colors hover:font-semibold hover:text-encre"
            >
              <img src="/images/figma-icon-linkedin.svg" alt="" aria-hidden="true" class="size-6" />
              linkedin.com/in/audrey-garoscio<span class="sr-only"> (nouvel onglet)</span>
            </a>
          </li>
        </ul>
      </div>

      <p class="note -rotate-3 text-3xl font-normal sm:text-[36px] lg:absolute lg:right-[10%] lg:top-4">
        Concevoir avec sens,<br />livrer avec impact.
      </p>

      <div class="flex flex-wrap items-center gap-[14px]">
        <a
          href="/mentions-legales"
          class="rounded-[30px] px-5 py-2 text-base text-encre transition-colors hover:font-semibold"
        >
          Mentions légales
        </a>
        <a
          href="/mentions-legales"
          class="rounded-[30px] px-5 py-2 text-base text-encre transition-colors hover:font-semibold"
        >
          Politique de confidentialité
        </a>
      </div>
    </div>

    <div class="flex flex-col items-center justify-center border-t border-trait-2 pt-5">
      <p class="text-xs text-voile-fort">© {year} Garoscio Audrey — Product Designer UX/UI</p>
    </div>
  </div>
</footer>
