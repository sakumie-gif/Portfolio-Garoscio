---
// Bascule jour / salle obscure, en toggle textuel "Clair / Sombre".
// Le mot actif (selon la classe .dark sur <html>) est en 500 / encre,
// l'inactif en 400 / voile.
//
// Accessibilité :
//   - les états passent par les tokens de couleur, et non par opacity :
//     opacity-55 sur encre ne donnait que 3.77:1 en mode clair ;
//   - l'aria-label commence par le texte visible "Clair / Sombre", pour que
//     la commande vocale reconnaisse ce qui est à l'écran (WCAG 2.5.3) ;
//   - la "/" est décorative, donc retirée de l'arbre d'accessibilité ;
//   - py-1.5 porte la cible à ≥24px de haut (WCAG 2.2 SC 2.5.8).
---

<button
  type="button"
  id="theme-toggle"
  class="-my-1.5 py-1.5 font-display text-[13px] italic text-encre"
  aria-label="Clair / Sombre — basculer le mode d'affichage"
  aria-pressed="false"
>
  <span class="font-medium text-encre dark:font-normal dark:text-voile">Clair</span>
  <span class="mx-2 text-voile" aria-hidden="true">/</span>
  <span class="font-normal text-voile dark:font-medium dark:text-encre">Sombre</span>
</button>

<script>
  const btn = document.getElementById("theme-toggle");
  if (btn) {
    const sync = () =>
      btn.setAttribute(
        "aria-pressed",
        document.documentElement.classList.contains("dark") ? "true" : "false",
      );
    // Le HTML sort du serveur avec aria-pressed="false" ; on rectifie dès que
    // possible pour ceux qui chargent la page déjà en mode sombre.
    sync();
    btn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch (e) {
        /* stockage indisponible : la bascule vaut pour la page courante */
      }
      sync();
    });
  }
</script>
