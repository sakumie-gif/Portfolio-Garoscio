---
// Rideau d'ouverture — deux pans blancs abstraits, pas une photo de velours.
// Le plissé est suggéré par un dégradé répété, l'ombre reste très légère, et
// une lumière corail apparaît derrière au moment de l'écartement.
//
// Accessibilité — le rideau est purement décoratif, donc il ne doit JAMAIS
// pouvoir retenir la page :
//   - masqué par défaut, révélé seulement si le script s'exécute ;
//   - aucune capture de clic une fois l'ouverture lancée (2.1.1 / 2.4.11) ;
//   - fermable au clavier autant qu'à la souris, en plus de l'auto-ouverture ;
//   - hors de l'arbre d'accessibilité (aria-hidden).
---

<div id="curtain" class="curtain" aria-hidden="true">
  <div class="curtain-glow"></div>
  <div class="curtain-panel curtain-panel--left"></div>
  <div class="curtain-panel curtain-panel--right"></div>
</div>

<style>
  /* Masqué par défaut : sans JS (ou si le script échoue), aucun rideau
     n'apparaît et la page reste utilisable. Le script ajoute .is-live. */
  .curtain {
    display: none;
  }

  .curtain.is-live {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    cursor: pointer;
    overflow: hidden;
  }

  /* La lumière de scène, derrière les pans. Corail en surface pure :
     aucun texte ne repose dessus, la règle de contraste ne s'applique pas. */
  .curtain-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    height: 60vmax;
    width: 60vmax;
    transform: translate(-50%, -50%) scale(0.6);
    background: radial-gradient(
      circle,
      rgba(242, 111, 98, 0.5) 0%,
      rgba(244, 215, 108, 0.28) 38%,
      rgba(252, 250, 247, 0) 70%
    );
    opacity: 0;
    transition: opacity 0.5s ease, transform 1.2s ease-out;
  }

  /* Deux pans qui couvrent l'écran et s'écartent vers les bords.
     Le plissé : des bandes verticales très basse intensité, pas une texture. */
  .curtain-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50.5%; /* léger recouvrement au centre, pas de liseré */
    background-color: #fcfaf7;
    background-image: repeating-linear-gradient(
      90deg,
      rgba(30, 28, 28, 0.05) 0px,
      rgba(30, 28, 28, 0) 14px,
      rgba(30, 28, 28, 0.035) 30px,
      rgba(30, 28, 28, 0) 46px
    );
    transition: transform 1.2s cubic-bezier(0.65, 0, 0.2, 1);
    will-change: transform;
  }

  .curtain-panel--left {
    left: 0;
    box-shadow: 6px 0 24px -8px rgba(30, 28, 28, 0.14);
  }

  .curtain-panel--right {
    right: 0;
    box-shadow: -6px 0 24px -8px rgba(30, 28, 28, 0.14);
  }

  /* La lumière monte d'abord, seule, rideau encore fermé. */
  .curtain.is-ready .curtain-glow {
    opacity: 1;
  }

  /* Ouverture : les pans sortent par les côtés.
     pointer-events dès cet instant : la page redevient cliquable
     immédiatement, sans attendre la fin de la transition. */
  .curtain.is-open {
    pointer-events: none;
  }
  .curtain.is-open .curtain-glow {
    transform: translate(-50%, -50%) scale(1.5);
    opacity: 0;
  }
  .curtain.is-open .curtain-panel--left {
    transform: translateX(-100%);
  }
  .curtain.is-open .curtain-panel--right {
    transform: translateX(100%);
  }

  /* Une fois fini, on retire le rideau du chemin */
  .curtain.is-done {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .curtain,
    .curtain.is-live {
      display: none;
    }
  }
</style>

<script>
  const curtain = document.getElementById("curtain");

  // sessionStorage jette une SecurityError quand le stockage est bloqué
  // (cookies désactivés, certaines politiques d'entreprise). Sans ce garde,
  // le script mourrait ici et le rideau resterait affiché indéfiniment.
  const lireVues = () => {
    try {
      return Number(sessionStorage.getItem("curtain-vues") || "0");
    } catch (e) {
      return 0;
    }
  };
  const ecrireVues = (n: number) => {
    try {
      sessionStorage.setItem("curtain-vues", String(n));
    } catch (e) {
      /* stockage indisponible : on continue sans mémoriser */
    }
  };

  // On ne montre le rideau que 2 fois par session : un recruteur ne doit pas
  // revoir l'animation à chaque page.
  // En développement (npm run dev), la limite est désactivée pour les tests.
  const MAX_PAR_SESSION = 2;
  const enDev = import.meta.env.DEV;
  const vues = lireVues();

  // Respecte le choix système : pas d'animation d'intro du tout.
  const reduit = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (curtain && (reduit || (!enDev && vues >= MAX_PAR_SESSION))) {
    // Quota atteint ou animation non souhaitée : on retire le rideau.
    curtain.remove();
  } else if (curtain) {
    if (!enDev) ecrireVues(vues + 1);

    // Durées (ms). Le concept fixe l'ouverture à 1 à 1,5 s : DUREE_ECARTEMENT
    // doit rester aligné sur la transition CSS des pans (1.2s).
    const TEMPS_AFFICHAGE = 900; // combien de temps le rideau reste fermé
    const DELAI_ANTI_CLIC = 500; // on ignore les interactions pendant ce délai
    const DUREE_ECARTEMENT = 1300;

    let opened = false;
    const open = () => {
      if (opened) return;
      opened = true;
      curtain.classList.add("is-open");
      window.removeEventListener("keydown", onKey);
      setTimeout(() => curtain.classList.add("is-done"), DUREE_ECARTEMENT);
    };
    const onKey = () => open();

    // Plus d'image à précharger : on peut démarrer au premier rendu.
    curtain.classList.add("is-live");
    requestAnimationFrame(() => curtain.classList.add("is-ready"));

    // L'ouverture n'est active qu'après un court délai, pour éviter
    // qu'une interaction involontaire ne ferme le rideau aussitôt.
    setTimeout(() => {
      curtain.addEventListener("click", open);
      // Équivalent clavier du clic : n'importe quelle touche lève le
      // rideau. Le div n'est pas focusable, on écoute donc la fenêtre.
      window.addEventListener("keydown", onKey);
    }, DELAI_ANTI_CLIC);

    // Auto-ouverture après le temps d'affichage.
    setTimeout(open, TEMPS_AFFICHAGE);
  }
</script>
