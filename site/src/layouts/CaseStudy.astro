---
import Base from "./Base.astro";

const {
  title,
  kicker,
  didascalie,
  sections = [],
  accent = "rose", // rose | brume | sauge
} = Astro.props;

const accentClass = {
  rose: "bg-rose",
  brume: "bg-brume",
  sauge: "bg-sauge",
}[accent];
---

<Base title={`${title} — Audrey Garoscio`} current="works">
  <article class="mx-auto max-w-5xl px-6 sm:px-10">
    <!-- En-tête du case study -->
    <header class="border-b border-voile/20 pb-12 pt-6">
      <a
        href="/works"
        class="text-sm text-voile transition-colors hover:text-encre"
      >
        ← La saison
      </a>
      {kicker && (
        <p class="mt-8 text-sm uppercase tracking-[0.18em] text-voile">
          {kicker}
        </p>
      )}
      <h1 class="mt-3 font-display text-4xl font-semibold leading-tight sm:text-5xl">
        {title}
      </h1>
      {didascalie && (
        <p class="mt-5 max-w-xl font-display text-lg italic leading-relaxed text-voile">
          {didascalie}
        </p>
      )}
      <span class:list={["mt-8 block h-px w-16", accentClass]}></span>
    </header>

    <!-- Corps: sidebar TOC + contenu -->
    <div class="grid grid-cols-1 gap-12 pt-12 lg:grid-cols-[200px_1fr] lg:gap-16">
      <!-- Table des matières (desktop) -->
      {
        sections.length > 0 && (
          <aside class="hidden lg:block">
            <nav class="sticky top-24" aria-label="Sommaire">
              <p class="mb-4 text-xs uppercase tracking-[0.18em] text-voile">
                Sommaire
              </p>
              <ul class="space-y-3 text-sm">
                {sections.map((s) => (
                  <li>
                    <a
                      href={`#${s.id}`}
                      class="text-voile transition-colors hover:text-encre"
                    >
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }

      <!-- Contenu -->
      <div class="cs-content max-w-[65ch] pb-8">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style is:global>
  /* Mise en forme du contenu d'un case study */
  .cs-content h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1.25;
    margin-top: 3.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 6rem;
  }
  .cs-content h2:first-child {
    margin-top: 0;
  }
  .cs-content h3 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.05rem;
    margin-top: 2.25rem;
    margin-bottom: 0.5rem;
  }
  .cs-content p {
    margin-bottom: 1.25rem;
  }
  .cs-content .citation {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.4;
    color: var(--color-encre);
    margin: 3rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-rose);
  }
  .cs-content .meta {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-voile) 25%, transparent);
    font-size: 0.9rem;
    color: var(--color-voile);
  }
  .cs-content .meta strong {
    color: var(--color-encre);
    font-weight: 600;
  }
  .cs-content figure {
    margin: 2.5rem 0;
  }
  .cs-content figure img {
    width: 100%;
    border-radius: 2px;
  }
  .cs-content figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--color-voile);
  }
</style>
