---
import Base from "./Base.astro";

const {
  title,
  kicker,
  didascalie,
  sections = [],
  accent = "rose", // rose | brume | jaune
} = Astro.props;

// Teinte décorative de l'en-tête. Ces aplats ne portent jamais de texte :
// aucune contrainte de contraste ne s'y applique.
const accentClass = {
  rose: "bg-rose",
  brume: "bg-brume",
  jaune: "bg-jaune",
}[accent];
---

<Base title={`${title} — Audrey Garoscio`} current="works">
  <article class="mx-auto max-w-6xl px-6 sm:px-10">
    <!-- En-tête du case study -->
    <header class="relative border-b border-encre/10 pb-14 pt-6">
      <div
        class:list={["blob right-0 top-2 h-64 w-64 opacity-70", accentClass]}
        aria-hidden="true"
      >
      </div>

      <a
        href="/works"
        class="group inline-flex items-center gap-2 text-sm text-voile transition-colors hover:text-encre"
      >
        <span class="inline-block transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
        Tous les projets
      </a>
      {kicker && (
        <p class="mt-10 text-xs uppercase tracking-[0.2em] text-bordeaux">
          {kicker}
        </p>
      )}
      <h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-[1.05] sm:text-6xl">
        {title}
      </h1>
      {didascalie && (
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-voile">
          {didascalie}
        </p>
      )}
    </header>

    <!-- Corps: sidebar TOC + contenu -->
    <div
      class:list={[
        "grid grid-cols-1 gap-12 pt-12 lg:gap-16",
        sections.length > 0 && "lg:grid-cols-[200px_1fr]",
      ]}
    >
      <!-- Table des matières (desktop) -->
      {
        sections.length > 0 && (
          <aside class="hidden lg:block">
            <nav class="sticky top-24" aria-label="Sommaire">
              <p class="mb-4 text-xs uppercase tracking-[0.2em] text-accent">
                Sommaire
              </p>
              <ul class="space-y-3 text-sm">
                {sections.map((s) => (
                  <li>
                    <a
                      href={`#${s.id}`}
                      class="block text-voile transition-colors hover:font-semibold hover:text-encre"
                    >
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }

      <!-- Contenu -->
      <div class="cs-content max-w-[65ch] pb-8">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style is:global>
  /* Mise en forme du contenu d'un case study */
  .cs-content h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin-top: 3.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 6rem;
  }
  .cs-content h2:first-child {
    margin-top: 0;
  }
  .cs-content h3 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.05rem;
    margin-top: 2.25rem;
    margin-bottom: 0.5rem;
  }
  .cs-content p {
    margin-bottom: 1.25rem;
  }
  /* Citation — bordeaux, l'une des rares places que le concept lui laisse. */
  .cs-content .citation {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    line-height: 1.35;
    color: var(--color-bordeaux);
    margin: 3rem 0;
    padding-left: 1.5rem;
    border-left: 3px solid var(--color-corail);
  }
  .cs-content .meta {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-voile) 25%, transparent);
    font-size: 0.9rem;
    color: var(--color-voile);
  }
  .cs-content .meta strong {
    color: var(--color-encre);
    font-weight: 600;
  }
  .cs-content figure {
    margin: 2.5rem 0;
  }
  .cs-content figure img {
    width: 100%;
    border-radius: 16px 16px 16px 3px;
  }
  .cs-content figcaption {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    color: var(--color-voile);
  }
</style>
